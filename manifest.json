{
  "manifest_version": 3,
  "name": "AMO CRM Priority Manager",
  "version": "1.9.0",
  "description": "Умная подсветка клиентов по приоритетам",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AMO CRM Priority Manager"
  },
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://infoind.amocrm.ru/todo*",
        "*://infoind.amocrm.ru/leads*"
      ],
      "js": ["content.js"],
      "css": ["content-styles.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
        "resources": [
            "changelog.json",
            "sidebar/sidebar.html",
            "sidebar/sidebar.js",
            "sidebar/sidebar.css",
            "shared/common.css",
            "shared/statuses.js",
            "shared/storage.js"
        ],
        "matches": ["*://infoind.amocrm.ru/*"]
    }
  ]
}