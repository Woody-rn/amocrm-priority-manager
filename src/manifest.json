{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.1.0",
  "description": "Умная подсветка клиентов по приоритетам в amoCRM",
  "default_locale": "ru",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://*.amocrm.ru/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AMO CRM Priority Manager"
  },
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.amocrm.ru/*"],
      "js": ["content/index.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "changelog.json",
        "sidebar/sidebar.html",
        "sidebar/sidebar.css",
        "sidebar/index.js",
        "sidebar/render.js",
        "sidebar/filters.js",
        "shared/styles/common.css"
      ],
      "matches": ["*://*.amocrm.ru/*"]
    }
  ]
}